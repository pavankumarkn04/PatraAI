{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run PatraAI",
      "type": "process",
      "command": "py",
      "args": [
        "-3.11",
        "${workspaceFolder}/run_app.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Stop PatraAI",
      "type": "process",
      "command": "py",
      "args": [
        "-3.11",
        "${workspaceFolder}/run_app.py",
        "--stop"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
