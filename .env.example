# Copy this file to .env. Keep secrets here; the website never asks for them.
# HF_TOKEN is needed to download gated model weights or authenticate a hosted endpoint.
HF_TOKEN=
PATRAM_MODEL=bharatgenai/patram-7b-instruct
# Optional: configure a running Patram-compatible OpenAI chat endpoint.
# Leave blank to use the explicitly disclosed local Ollama analysis fallback.
# Local vLLM example: http://127.0.0.1:8000/v1/chat/completions
HF_CHAT_COMPLETIONS_URL=
# Translation runs on-device through Ollama by default. These values are
# optional and override the local defaults if needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# qwen3.5:4b (3.4 GB) is used for both text and scanned pages: one model fits in
# memory on a 16 GB laptop. gemma4:e4b (9.6 GB) is slower when RAM is short.
OLLAMA_TEXT_MODEL=qwen3.5:4b
# Retry a local generation if Ollama aborts it for repetitive tokens.
OLLAMA_FALLBACK_MODEL=qwen3.5:4b
OLLAMA_TRANSLATION_MODEL=qwen3.5:4b
# Optional local vision model for scanned PDF/image analysis. Install with:
# ollama pull qwen3.5:4b
OLLAMA_VISION_MODEL=qwen3.5:4b
# Optional image-model retry after Ollama's repetitive-token abort.
OLLAMA_VISION_FALLBACK_MODEL=gemma4:e4b
# Page classification: pages with at least MIN_PAGE_TEXT_CHARS selectable
# characters are read as text. Pages with less text are OCR'd only when a large
# image covers them (SCANNED_IMAGE_COVERAGE) or they show ink with no text.
MIN_PAGE_TEXT_CHARS=120
SCANNED_IMAGE_COVERAGE=0.25
# Documents up to SINGLE_CALL_TOKENS (estimated model tokens; default
# OLLAMA_NUM_CTX - 3300) are analyzed in one model call that returns the fields
# and the summary together. Longer documents use one field-extraction call over
# FIELD_EVIDENCE_CHARS of selected passages, plus up to SUMMARY_MAX_SECTIONS
# section summaries. Token estimates use these measured characters per token
# (qwen3.5:4b): English/Latin text and Indian scripts.
# SINGLE_CALL_TOKENS=4892
LATIN_CHARS_PER_TOKEN=4.0
INDIC_CHARS_PER_TOKEN=1.4
FIELD_EVIDENCE_CHARS=9000
SUMMARY_SECTION_CHARS=4500
SUMMARY_MAX_SECTIONS=5
QA_RETRIEVAL_TOP_K=4
QA_CHUNK_CHARS=1200
# Characters repeated between neighbouring question-answering chunks of a page.
QA_CHUNK_OVERLAP=150
# Documents up to this size (halved for Indian scripts) and page count are
# given to the question-answering model whole instead of retrieved excerpts.
QA_FULL_CONTEXT_CHARS=7000
QA_FULL_CONTEXT_PAGES=12
# Server log level (stage timings and model names only; never document text).
PATRAAI_LOG_LEVEL=WARNING
# One fixed context size avoids model reloads between calls.
OLLAMA_NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m
# Decode analysis replies against a JSON schema (Ollama 0.5 or later), so the
# summary is never missing and list items are plain text. 0 = plain JSON mode.
OLLAMA_STRUCTURED_OUTPUT=1
# Per-request limits for model services (seconds).
MODEL_TIMEOUT_SECONDS=300
MODEL_CONNECT_TIMEOUT_SECONDS=10
# Optional Tesseract installed language codes; only installed packs are used.
TESSERACT_LANGS=eng+hin+kan+tam+tel+mal+pan
TESSERACT_CMD=
TESSDATA_PREFIX=
# AI4Bharat IndicTrans2 runs locally once HF_TOKEN (above) has access to the
# gated model. Set INDICTRANS2_LOCAL=0 to turn the local model off.
INDICTRANS2_MODEL=ai4bharat/indictrans2-en-indic-dist-200M
INDICTRANS2_LOCAL=auto
INDICTRANS2_BEAMS=4
# Sentences per IndicTrans2 batch (batches are sorted by length), and the
# longest piece sent at once: longer sentences are split at clause boundaries
# instead of being cut off at the model's 256-token limit.
INDICTRANS2_BATCH=32
INDICTRANS2_MAX_CHARS=400
# Optional override: a running IndicTrans2-compatible HTTP service.
INDIC_TRANS2_URL=
INDIC_TRANS2_TOKEN=
